{
  "name": "party-photo-slideshow",
  "version": "1.0.0",
  "description": "Photo upload and slideshow server for Raspberry Pi",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "build:pi": "npm run build && pkg dist/server.js --targets node18-linux-arm64 --output slideshow-pi"
  },
  "bin": "./dist/server.js",
  "pkg": {
    "assets": [
      "node_modules/better-sqlite3/**/*"
    ],
    "outputPath": "build"
  },
  "keywords": ["photo", "slideshow", "raspberry-pi", "party"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "better-sqlite3": "^9.2.2",
    "multer": "^1.4.5-lts.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/cors": "^2.8.17",
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.10.6",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0",
    "pkg": "^5.8.1"
  }
}
