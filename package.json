{
  "name": "party-photo-slideshow",
  "version": "1.0.0",
  "description": "Photo upload and slideshow server for Raspberry Pi",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "build:pi": "npm run build && npx -y pkg@5.8.1 dist/server.js --target node18-linuxstatic-armv7 --output build/slideshow-pi --public --public-packages \"*\" --no-bytecode --compress GZip"
  },
  "keywords": [
    "photo",
    "slideshow",
    "raspberry-pi",
    "party"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.67.0",
    "better-sqlite3": "^9.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.6",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "caxa": {
    "exclude": [
      "src",
      "*.md",
      ".git",
      "tsconfig.json"
    ]
  }
}
